		</dict>
	</dict>
	<key>%lu indexes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lu</string>
			<key>one</key><string>%lu indeks</string>
			<key>few</key><string>%lu indeksy</string>
			<key>many</key><string>%lu indeksów</string>
			<key>other</key><string>%lu indeksów</string>
		</dict>
	</dict>
	<key>%lu statements</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lu</string>
			<key>one</key><string>%lu instrukcja</string>
			<key>few</key><string>%lu instrukcje</string>
			<key>many</key><string>%lu instrukcji</string>
			<key>other</key><string>%lu instrukcji</string>
		</dict>
	</dict>
	<key>%lu matching rows</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key><string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key><string>lu</string>
			<key>one</key><string>%lu pasujący wiersz</string>
			<key>few</key><string>%lu pasujące wiersze</string>
			<key>many</key><string>%lu pasujących wierszy</string>
			<key>other</key><string>%lu pasujących wierszy</string>
		</dict>
	</dict>
	<key>%lu databases</key>
	<dict>
